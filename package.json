{
  "name": "dcs",
  "version": "0.1.0",
  "private": true,
  "description": "DCS — Hệ Quản lý & Phân phối Tài liệu Điện tử",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:unit": "node --import tsx --test test/domain/**/*.test.ts",
    "test:constraints": "node --import tsx --test test/constraints.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/formbody": "7.4.0",
    "@fastify/static": "6.12.0",
    "argon2": "0.41.1",
    "eta": "3.5.0",
    "fastify": "4.28.1",
    "postgres": "3.4.5",
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "pino-pretty": "^11.2.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
