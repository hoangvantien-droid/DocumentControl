{
  "name": "dcs",
  "version": "0.2.0",
  "private": true,
  "description": "DCS — Hệ Quản lý & Phân phối Tài liệu Điện tử",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:unit": "node --import tsx --test test/domain/**/*.test.ts",
    "test:uat": "node --import tsx --test test/domain/permission-matrix.uat.test.ts test/uat/**/*.test.ts",
    "test:constraints": "node --import tsx --test test/constraints.test.ts",
    "gen:docs": "node scripts/gen-doc-features.mjs && node scripts/gen-doc-uat.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@fastify/cookie": "9.4.0",
    "@fastify/formbody": "7.4.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "6.12.0",
    "@modelcontextprotocol/sdk": "1.25.0",
    "argon2": "0.41.1",
    "eta": "3.5.0",
    "fastify": "4.28.1",
    "postgres": "3.4.5",
    "qrcode": "^1.5.4",
    "unpdf": "^0.12.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/qrcode": "^1.5.6",
    "docx": "^9.5.1",
    "pino-pretty": "^11.2.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
