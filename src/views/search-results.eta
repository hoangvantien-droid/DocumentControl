<% layout('layout.eta', { title: 'Kết quả tìm — DCS', user: it.user }) %>
<%
/* Trang kết quả tìm kiếm — bộ lọc đa chiều, áp tức thì bằng htmx.
 *   - Rail trái là MỘT form: mọi control có hx-get=/search/results, hx-trigger=change,
 *     hx-target=#search-results, hx-push-url=true -> lọc tức thì + đồng bộ URL để share.
 *   - Ô tìm q + nút Tìm cũng nằm trong form (submit = lọc lại).
 *   - #search-results chứa chip + đếm + danh sách (search-results-list.eta), swap khi lọc.
 */
const f = it.f || {};
const q = f.q || '';
const docTypes = ['SOP', 'WI', 'Form', 'Policy', 'External'];
const has = (arr, v) => (arr||[]).indexOf(v) !== -1;
%>

<h1>Kết quả tìm kiếm</h1>

<form method="get" action="/search" class="search-form"
      hx-get="/search/results" hx-target="#search-results" hx-swap="innerHTML"
      hx-trigger="change, submit, keyup changed delay:400ms from:input[name='q']" hx-push-url="true">

  <div class="search-bar-full">
    <input type="search" name="q" value="<%= q %>" placeholder="Tìm số hiệu, tiêu đề, nội dung…" autofocus>
    <label class="hist-toggle">
      <input type="checkbox" name="historical" value="1" <%= f.includeHistorical ? "checked" : "" %>>
      Bao gồm bản lịch sử
    </label>
    <button type="submit">Tìm</button>
  </div>

  <div class="search-layout">
    <aside class="search-filters">
      <input type="checkbox" id="filters-toggle" class="filters-toggle" aria-hidden="true">
      <label for="filters-toggle" class="filters-summary"><h2>Bộ lọc</h2></label>

      <fieldset>
        <legend>Loại tài liệu</legend>
        <% docTypes.forEach(function(t){ %>
          <label class="filter-check"><input type="checkbox" name="doc_type" value="<%= t %>" <%= has(f.docTypes, t) ? "checked" : "" %>> <%= t %></label>
        <% }) %>
      </fieldset>

      <fieldset>
        <legend>Nguồn</legend>
        <label class="filter-check"><input type="radio" name="origin" value="" <%= !f.origin ? "checked" : "" %>> Tất cả</label>
        <label class="filter-check"><input type="radio" name="origin" value="noi_bo" <%= f.origin==="noi_bo" ? "checked" : "" %>> Nội bộ</label>
        <label class="filter-check"><input type="radio" name="origin" value="ngoai_bo" <%= f.origin==="ngoai_bo" ? "checked" : "" %>> Bên ngoài</label>
      </fieldset>

      <fieldset>
        <legend>Phạm vi</legend>
        <select name="scope_level">
          <option value="">Tất cả phạm vi</option>
          <option value="group" <%= f.scopeLevel==="group" ? "selected" : "" %>>Toàn hệ thống</option>
          <option value="bu" <%= f.scopeLevel==="bu" ? "selected" : "" %>>Khối (BU)</option>
          <option value="site" <%= f.scopeLevel==="site" ? "selected" : "" %>>Nhà máy/Site</option>
          <option value="dept" <%= f.scopeLevel==="dept" ? "selected" : "" %>>Bộ phận</option>
        </select>
      </fieldset>

      <fieldset>
        <legend>Đơn vị cụ thể</legend>
        <label class="filter-select-label">Khối (BU)
          <select name="bu_id">
            <option value="">— Tất cả khối —</option>
            <% var _bus = it.bus || []; _bus.forEach(function(b){ %><option value="<%= b.bu_id %>" <%= f.buId===b.bu_id ? "selected" : "" %>><%= b.bu_code %> — <%= b.name %></option><% }) %>
          </select>
        </label>
        <label class="filter-select-label">Nhà máy/Site
          <select name="site_id">
            <option value="">— Tất cả site —</option>
            <% var _sts = it.sites || []; _sts.forEach(function(st){ %><option value="<%= st.site_id %>" <%= f.siteId===st.site_id ? "selected" : "" %>><%= st.site_code %> — <%= st.name %></option><% }) %>
          </select>
        </label>
        <label class="filter-select-label">Bộ phận
          <select name="dept_id">
            <option value="">— Tất cả bộ phận —</option>
            <% var _dps = it.depts || []; _dps.forEach(function(d){ %><option value="<%= d.dept_id %>" <%= f.deptId===d.dept_id ? "selected" : "" %>><%= d.dept_code %> — <%= d.name %></option><% }) %>
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend>Ngày hiệu lực</legend>
        <label class="filter-date">Từ <input type="date" name="eff_from" value="<%= f.effFrom || "" %>"></label>
        <label class="filter-date">Đến <input type="date" name="eff_to" value="<%= f.effTo || "" %>"></label>
      </fieldset>

      <fieldset>
        <legend>Cấp khớp</legend>
        <label class="filter-check"><input type="checkbox" name="match_level" value="doc_id" <%= has(f.matchLevels, "doc_id") ? "checked" : "" %>> Số hiệu</label>
        <label class="filter-check"><input type="checkbox" name="match_level" value="document" <%= has(f.matchLevels, "document") ? "checked" : "" %>> Tiêu đề</label>
        <label class="filter-check"><input type="checkbox" name="match_level" value="section" <%= has(f.matchLevels, "section") ? "checked" : "" %>> Nội dung mục</label>
        <label class="filter-check"><input type="checkbox" name="match_level" value="fulltext" <%= has(f.matchLevels, "fulltext") ? "checked" : "" %>> Toàn văn</label>
      </fieldset>

      <fieldset>
        <legend>Sắp xếp</legend>
        <select name="sort">
          <option value="" <%= !f.sort ? "selected" : "" %>>Liên quan nhất</option>
          <option value="eff_new" <%= f.sort==="eff_new" ? "selected" : "" %>>Mới hiệu lực</option>
          <option value="doc_id" <%= f.sort==="doc_id" ? "selected" : "" %>>Số hiệu</option>
        </select>
      </fieldset>

      <a class="filter-clear" href="/search?q=<%= encodeURIComponent(q) %>">Xoá tất cả lọc</a>
    </aside>

    <div class="search-results-col" id="search-results">
      <%~ include('/search-results-list.eta', { q: q, hits: it.hits, f: f }) %>
    </div>
  </div>
</form>
