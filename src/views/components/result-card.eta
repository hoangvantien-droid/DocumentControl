<%
/* components/result-card.eta — Thẻ kết quả tìm kiếm (Yêu cầu 9.2–9.5), bản làm giàu.
 *
 * Chỉ trình bày — an toàn với prop thiếu (mặc định hit = {}). Các trường làm giàu
 * (scope_level, effective_date, department_name, origin) do migration 023 cấp;
 * nếu thiếu thì bỏ qua phần tương ứng (tương thích ngược).
 */
const hit = it.hit || {};
const isHistorical = hit.status && hit.status !== 'hieu_luc' && hit.status !== 'da_ban_hanh';
function matchText(m){
  switch (m) {
    case 'doc_id': return 'khớp số hiệu';
    case 'doc_id_partial': return 'khớp số hiệu';
    case 'document': return 'khớp tiêu đề';
    case 'section': return 'khớp nội dung mục';
    case 'fulltext': return 'khớp toàn văn';
    default: return m || '';
  }
}
function fmtDate(d){ return d ? String(d).slice(0,10) : ''; }
%>
<li class="result-card<%= isHistorical ? " result-card--historical" : "" %>">
  <div class="result-card__line1">
    <a href="/documents/<%= hit.version_id %>"><strong><%= hit.doc_id %></strong> — <%= hit.title %></a>
    <%~ include('/components/status-label.eta', { kind: 'doc', code: hit.status, text: hit.status }) %>
    <% if (hit.scope_level) { %>
      <%~ include('/components/status-label.eta', { kind: 'scope', level: hit.scope_level, text: hit.scope_level }) %>
    <% } %>
  </div>
  <div class="result-card__line2">
    Phiên bản <%= hit.version_no %>
    <% if (hit.effective_date) { %> · Hiệu lực <%= fmtDate(hit.effective_date) %><% } %>
    <% if (hit.department_name) { %> · <%= hit.department_name %><% } %>
    · <%= matchText(hit.match_level) %>
  </div>
  <% if (hit.match_level === 'section' && hit.snippet) { %>
    <div class="result-card__snippet"><strong><%= hit.section_code %> <%= hit.section_title %>:</strong> <span class="hl"><%= hit.snippet %></span></div>
  <% } else if (hit.match_level === 'fulltext' && hit.snippet) { %>
    <div class="result-card__snippet"><span class="hl"><%= hit.snippet %></span></div>
  <% } %>
  <% if (isHistorical) { %>
    <% if (hit.current_version_no) { %>
      <div class="result-card__superseded">Bản đã hết hiệu lực — bản đang áp dụng: phiên bản <%= hit.current_version_no %>.</div>
    <% } else { %>
      <div class="result-card__superseded">Bản đã hết hiệu lực — hãy mở bản đang áp dụng hiện hành.</div>
    <% } %>
  <% } %>
</li>
