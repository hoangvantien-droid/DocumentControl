<%
/* components/site-response-matrix.eta — Ma trận phản hồi theo site cho một
 * phiên bản. Tự vệ: nếu hàm nhãn không được include truyền vào (Eta include
 * KHÔNG kế thừa biến global của render), dùng map cục bộ để không bao giờ 500.
 *
 * Props: receipts (mảng ReceiptRow); tùy chọn receiptStatusLabel,
 *        receiptRejectTypeLabel.
 */
const receipts = it.receipts || [];
const RS = { cho_phan_hoi: 'Chờ phản hồi', chap_nhan: 'Đã chấp nhận', tu_choi: 'Đã từ chối' };
const RT = { sai_dang_ky: 'Sai thông tin đăng ký', sai_noi_dung: 'Sai nội dung tài liệu' };
const statusLabel = typeof it.receiptStatusLabel === 'function' ? it.receiptStatusLabel : (c) => RS[c] || c || '';
const rejectLabel = typeof it.receiptRejectTypeLabel === 'function' ? it.receiptRejectTypeLabel : (c) => RT[c] || c || '';
%>
<table class="data-table site-matrix">
  <thead><tr><th>Site</th><th>Trạng thái</th><th>Ngày áp dụng</th><th>Phản hồi lúc</th><th>Ghi chú</th></tr></thead>
  <tbody>
    <% receipts.forEach(function(r){ %>
    <tr>
      <td><%= r.site_code %> — <%= r.site_name %></td>
      <td><span class="status status-<%= r.status === 'tu_choi' ? 'thu_hoi' : (r.status === 'chap_nhan' ? 'hieu_luc' : 'da_ban_hanh') %>"><%= statusLabel(r.status) %></span></td>
      <td><%= r.apply_date || '' %></td>
      <td><%= (r.responded_at || '').slice(0, 10) %></td>
      <td>
        <% if (r.status === 'tu_choi') { %>
          <strong><%= rejectLabel(r.response_type) %></strong>
          <% if (r.response_note) { %><div class="reject-reason"><%= r.response_note %></div><% } %>
        <% } %>
      </td>
    </tr>
    <% }) %>
    <% if (receipts.length === 0) { %><tr><td colspan="5">Chưa phát hành tới site nào.</td></tr><% } %>
  </tbody>
</table>
