<% layout('layout.eta', { title: 'Chi tiết — DCS', user: it.user }) %>
<% var d = it.d; %>

<div class="detail-header">
  <h1><%= d.doc_id %> — phiên bản <%= d.version_no %></h1>
  <p class="doc-title">
    <%= d.title %>
    · <%~ include('/components/status-label.eta', { kind: 'doc', code: d.status, text: d.status }) %>
    <%~ include('/components/status-label.eta', { kind: 'scope', level: d.scope_level, text: d.scope_level }) %>
  </p>

  <div class="detail-actions">
    <a href="/documents/<%= d.version_id %>/view" target="_blank" rel="noopener" class="btn-link">Mở PDF toàn màn hình</a>
    <a href="/documents/<%= d.version_id %>/download" class="btn-link">Tải PDF</a>
    <% if (d.status === 'hieu_luc' || d.status === 'da_ban_hanh') { %>
      <details class="print-box">
        <summary class="btn-diff">In bản sao có kiểm soát</summary>
        <form method="post" action="/documents/<%= d.version_id %>/print" class="inline-form">
          <label>Site áp dụng (gắn vào mã QR để tra cứu theo site)
            <select name="site_id">
              <option value="">— Không gắn site (tra cứu chung) —</option>
              <% var _sites = it.sites || []; _sites.forEach(function(st){ %><option value="<%= st.site_id %>"><%= st.site_code %> — <%= st.name %></option><% }) %>
            </select>
          </label>
          <label>Vị trí đặt bản in (tuỳ chọn)
            <input name="location" placeholder="VD: Chuyền 1, phòng QA…">
          </label>
          <button type="submit" class="primary">Tạo bản sao có kiểm soát</button>
        </form>
      </details>
    <% } %>
    <% if (it.nav && it.nav.canReport) { %>
      <button type="button" class="btn-link" onclick="var b=document.getElementById('report-box');b.hidden=!b.hidden">Báo bất thường</button>
    <% } %>
  </div>
  <% if (it.nav && it.nav.canReport) { %>
  <form id="report-box" method="post" action="/documents/<%= d.version_id %>/report" class="report-inline" hidden>
    <label>Mô tả bất thường bạn phát hiện <span class="req">*</span>
      <textarea name="note" rows="2" required placeholder="Ví dụ: sai ngày ban hành, nội dung không khớp thực tế…"></textarea>
    </label>
    <button type="submit" class="btn-diff">Gửi báo cáo tới kiểm soát tài liệu site</button>
  </form>
  <% } %>
</div>

<% if (d.status === 'het_hieu_luc') { %>
  <%~ include('/components/alert-banner.eta', { type: 'error', text: 'Bản này ĐÃ HẾT HIỆU LỰC.' }) %>
  <% if (it.current) { %>
    <p class="detail-alert-link">Bản đang áp dụng: <a href="/documents/<%= it.current.version_id %>">phiên bản <%= it.current.version_no %></a>.</p>
  <% } %>
<% } else if (d.status === 'thu_hoi') { %>
  <%~ include('/components/alert-banner.eta', { type: 'error', text: 'Tài liệu ĐÃ THU HỒI. Lý do: ' + (d.recall_reason || '') }) %>
<% } else if (d.qua_han_xem_xet) { %>
  <%~ include('/components/alert-banner.eta', { type: 'warning', text: 'Tài liệu QUÁ HẠN RÀ SOÁT.' }) %>
<% } %>

<% if (it.ackState && it.ackState.show) { %>
  <form method="post" action="/documents/<%= d.version_id %>/acknowledge">
    <button type="submit" class="primary">Xác nhận đã đọc</button>
  </form>
<% } else if (it.ackState && it.ackState.done) { %>
  <p class="ack-done">
    <% if (it.ackState.inherited) { %>Đã xác nhận (kế thừa từ phiên bản trước do thay đổi nhỏ).<% } else { %>Bạn đã xác nhận đọc bản này.<% } %>
  </p>
<% } %>

<!-- Dải thông tin ngang: không chiếm chiều ngang của khung PDF -->
<dl class="detail-info-bar">
  <div><dt>Loại</dt><dd><%= d.doc_type %> (<%= d.origin %>)</dd></div>
  <div><dt>Phạm vi</dt><dd><%= it.scopeLabel(d.scope_level) %></dd></div>
  <div><dt>Ngày áp dụng dự kiến</dt><dd><%= d.issued_date || '' %></dd></div>
  <div><dt>Ngày có hiệu lực</dt><dd><%= d.effective_date || '' %></dd></div>
  <div><dt>Xem xét tới</dt><dd><%= d.next_review_date || '' %></dd></div>
</dl>

<!-- Nội dung chính: PDF gốc, toàn chiều rộng -->
<section class="pdf-viewer">
  <iframe class="pdf-frame" src="/documents/<%= d.version_id %>/view" title="Nội dung PDF tài liệu"></iframe>
  <p class="pdf-fallback muted">Không hiển thị được PDF? <a href="/documents/<%= d.version_id %>/view" target="_blank" rel="noopener">Mở ở tab mới</a> hoặc <a href="/documents/<%= d.version_id %>/download">tải về</a>.</p>
</section>

<!-- Thông tin phụ: gập xuống dưới, không tranh chỗ với PDF -->
<details class="detail-panel">
  <summary>Nội dung bóc tách (văn bản)</summary>
  <% if (it.sections.length === 0) { %>
    <p class="muted">Chưa bóc tách nội dung.</p>
    <% if (it.isRegistrant) { %>
    <form method="post" action="/documents/<%= d.version_id %>/process">
      <button type="submit" class="btn-diff">Bóc tách nội dung từ tệp</button>
    </form>
    <% } %>
  <% } else { %>
    <% it.sections.forEach(function(s){ %>
      <div class="section-block"><h3><%= s.section_code %> <%= s.section_title %></h3><p><%= s.raw_text || '' %></p></div>
    <% }) %>
  <% } %>
</details>

<details class="detail-panel">
  <summary>Nhãn liên kết</summary>
  <% if (it.links.length === 0) { %><p class="muted">Chưa có.</p><% } else { %>
    <% it.links.forEach(function(l){ %><span class="chip"><%= l.link_type %>: <%= l.link_code %></span><% }) %>
  <% } %>
</details>

<details class="detail-panel">
  <summary>Bản sao có kiểm soát đã in (<%= (it.printedCopies || []).length %>)</summary>
  <% if (!it.printedCopies || it.printedCopies.length === 0) { %>
    <p class="muted">Chưa in bản sao có kiểm soát nào.</p>
  <% } else { %>
    <table class="data-table responsive-table">
      <thead><tr><th>Ngày in</th><th>Người in</th><th>Vị trí</th><th>Tình trạng</th><th>Thao tác</th></tr></thead>
      <tbody>
        <% it.printedCopies.forEach(function(pc){ %>
        <tr>
          <td data-label="Ngày in"><%= (pc.printed_at || '').slice(0,16).replace('T',' ') %></td>
          <td data-label="Người in"><%= pc.printed_by_name || '' %></td>
          <td data-label="Vị trí"><%= pc.intended_location || '' %></td>
          <td data-label="Tình trạng">
            <% if (pc.recall_status === 'da_thu_hoi') { %>
              <span class="status status-thu_hoi">Đã thu hồi</span>
            <% } else { %>
              <span class="status status-hieu_luc">Đang lưu hành</span>
            <% } %>
          </td>
          <td data-label="Thao tác">
            <% if (pc.recall_status !== 'da_thu_hoi') { %>
            <form method="post" action="/documents/<%= d.version_id %>/print/recall" style="display:inline" onsubmit="return confirm('Thu hồi bản in này?')">
              <input type="hidden" name="print_id" value="<%= pc.print_id %>">
              <button type="submit" class="btn-diff">Thu hồi</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</details>

<details class="detail-panel">
  <summary>Lịch sử &amp; ghi vết</summary>
  <% if (it.history && it.history.length > 0) { %>
    <ul class="detail-history">
      <% it.history.forEach(function(h){ %>
        <li><a href="/documents/<%= h.version_id %>">phiên bản <%= h.version_no %></a> · <%= h.status %><% if (h.effective_date) { %> · <%= h.effective_date %><% } %></li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="muted"><a href="/audit?object_id=<%= d.version_id %>">Xem ghi vết đầy đủ của phiên bản này</a>.</p>
  <% } %>
</details>
