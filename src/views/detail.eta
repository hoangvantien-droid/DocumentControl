<% layout('layout.eta', { title: 'Chi tiết — DCS', user: it.user }) %>
<% var d = it.d; %>

<!-- Điều phải hiện nổi bật (DCS-7 §3.2) -->
<% if (d.status === 'het_hieu_luc') { %>
  <div class="danger-banner">
    Bản này ĐÃ HẾT HIỆU LỰC.
    <% if (it.current) { %> Bản đang áp dụng: <a href="/documents/<%= it.current.version_id %>">phiên bản <%= it.current.version_no %></a>.<% } %>
  </div>
<% } else if (d.status === 'thu_hoi') { %>
  <div class="danger-banner">Tài liệu ĐÃ THU HỒI. Lý do: <%= d.recall_reason %></div>
<% } else if (d.qua_han_xem_xet) { %>
  <div class="warn-banner">Tài liệu QUÁ HẠN RÀ SOÁT.</div>
<% } %>

<h1><%= d.doc_id %> — phiên bản <%= d.version_no %></h1>
<p class="doc-title"><%= d.title %> · <span class="status status-<%= d.status %>"><%= d.status %></span></p>

<!-- In bản kiểm soát (T-085): chỉ khi hiệu lực -->
<% if (d.status === 'hieu_luc') { %>
  <form method="post" action="/documents/<%= d.version_id %>/print" style="display:inline">
    <input type="hidden" name="location" value="">
    <button type="submit" class="btn-diff">In bản kiểm soát</button>
  </form>
<% } %>

<!-- Nút xác nhận đọc (T-069, DCS-7 §3.3) -->
<% if (it.ackState && it.ackState.show) { %>
  <form method="post" action="/documents/<%= d.version_id %>/acknowledge">
    <button type="submit" class="primary">Xác nhận đã đọc</button>
  </form>
<% } else if (it.ackState && it.ackState.done) { %>
  <p class="ack-done">
    <% if (it.ackState.inherited) { %>Đã xác nhận (kế thừa từ phiên bản trước do thay đổi nhỏ).<% } else { %>Bạn đã xác nhận đọc bản này.<% } %>
  </p>
<% } %>

<div class="detail-grid">
  <div class="detail-main">
    <h2>Nội dung</h2>
    <% if (it.sections.length === 0) { %>
      <p class="muted">Chưa bóc tách nội dung.</p>
      <form method="post" action="/documents/<%= d.version_id %>/process">
        <button type="submit" class="btn-diff">Bóc tách nội dung từ tệp</button>
      </form>
    <% } else { %>
      <% it.sections.forEach(function(s){ %>
        <div class="section-block"><h3><%= s.section_code %> <%= s.section_title %></h3><p><%= s.raw_text || '' %></p></div>
      <% }) %>
    <% } %>
  </div>

  <aside class="detail-side">
    <h2>Thông tin</h2>
    <dl>
      <dt>Loại</dt><dd><%= d.doc_type %> (<%= d.origin %>)</dd>
      <dt>Phạm vi</dt><dd><%= d.scope_level %></dd>
      <dt>Ngày ban hành</dt><dd><%= d.issued_date || '' %></dd>
      <dt>Người phê duyệt</dt><dd><%= d.approver_name || '' %></dd>
      <dt>Số hồ sơ phê duyệt</dt><dd><%= d.approval_reference || '' %></dd>
      <dt>Ngày hiệu lực</dt><dd><%= d.effective_date || '' %></dd>
      <dt>Rà soát tới</dt><dd><%= d.next_review_date || '' %></dd>
    </dl>

    <h3>Nhãn liên kết</h3>
    <% if (it.links.length === 0) { %><p class="muted">Chưa có.</p><% } else { %>
      <% it.links.forEach(function(l){ %><span class="chip"><%= l.link_type %>: <%= l.link_code %></span><% }) %>
    <% } %>

    <h3>Phân phối tới</h3>
    <% if (!it.matrix || it.matrix.length === 0) { %><p class="muted">Chưa khai.</p><% } else { %>
      <ul class="matrix-list">
        <% it.matrix.forEach(function(m){ %>
          <li>
            <%= m.department_code %><% if (m.functional_group_name) { %> ∩ <%= m.functional_group_name %><% } %>
            <% if (it.canRecallMatrix) { %>
              <form method="post" action="/documents/<%= d.version_id %>/matrix/remove" style="display:inline">
                <input type="hidden" name="matrix_id" value="<%= m.matrix_id %>">
                <button type="submit" class="chip-x">×</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <% if (it.canRecallMatrix) { %>
      <div hx-get="/documents/<%= d.version_id %>/matrix-options" hx-trigger="load" hx-swap="innerHTML"></div>
    <% } %>

    <% if (it.canRecall && (d.status === 'da_dang_ky' || d.status === 'hieu_luc')) { %>
      <p><a href="/documents/<%= d.version_id %>/recall" class="danger-link">Thu hồi tài liệu</a></p>
    <% } %>
  </aside>
</div>
