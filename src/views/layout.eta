<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title || 'DCS — Quản lý & Phân phối Tài liệu' %></title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
  <!-- Thanh điều hướng (DCS-7 §1.1): trái = tên hệ thống + ô tìm luôn hiện; phải = người dùng, vai trò, đăng xuất -->
  <header class="topbar">
    <div class="topbar-left">
      <a class="brand" href="/">DCS</a>
      <form class="search" action="/search" method="get" role="search">
        <input type="search" name="q" placeholder="Tìm số hiệu, tiêu đề, nội dung…" aria-label="Tìm kiếm" autocomplete="off">
      </form>
    </div>
    <div class="topbar-right">
      <% if (it.user) { %>
        <span class="user-name"><%= it.user.name %></span>
        <span class="user-role"><%= it.user.role %></span>
        <a class="logout" href="/logout">Đăng xuất</a>
      <% } else { %>
        <a class="logout" href="/login">Đăng nhập</a>
      <% } %>
    </div>
  </header>

  <div class="app-shell">
    <!-- Thực đơn bên (DCS-7 §1.2): ẩn hẳn mục không có quyền. Giai đoạn nền móng hiện đầy đủ. -->
    <nav class="sidebar" aria-label="Điều hướng chính">
      <ul>
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/search">Tìm kiếm nâng cao</a></li>
        <li><a href="/my-documents">Tài liệu của tôi</a></li>
        <li><a href="/pending-confirmation">Chờ tôi xác nhận</a></li>
        <li><a href="/reviews">Rà soát định kỳ</a></li>
        <li><a href="/packages">Gói ban hành</a></li>
        <li><a href="/functional-groups">Nhóm chức năng</a></li>
        <li><a href="/admin/org">Quản trị tổ chức</a></li>
        <li><a href="/audit">Ghi vết</a></li>
      </ul>
      <p class="phase-note">Giai đoạn 1 — L1 chưa vận hành</p>
    </nav>

    <main class="content">
      <%~ it.body %>
    </main>
  </div>
</body>
</html>
