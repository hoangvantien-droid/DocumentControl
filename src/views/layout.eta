<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title || 'DCS — Quản lý & Phân phối Tài liệu' %></title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
  <!-- Công tắc drawer điều hướng mobile (thuần CSS, không JS). Ẩn trên desktop;
       chỉ hiện/điều khiển trong @media (max-width:768px). -->
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
  <!-- Thanh điều hướng (DCS-7 §1.1) -->
  <header class="topbar">
    <div class="topbar-left">
      <label for="nav-toggle" class="nav-hamburger" aria-label="Mở menu"><span></span><span></span><span></span></label>
      <span class="brand-wrap">
        <a class="brand" href="/">DCS</a>
        <span class="brand-sub">Document Control System</span>
      </span>
      <form class="search" action="/search" method="get" role="search" autocomplete="off">
        <input type="search" name="q" placeholder="Tìm số hiệu, tiêu đề, nội dung…" aria-label="Tìm kiếm"
               hx-get="/search/suggest" hx-trigger="keyup changed delay:250ms" hx-target="#suggest-box" hx-swap="innerHTML">
        <div id="suggest-box" class="suggest-box"></div>
      </form>
    </div>
    <div class="topbar-right">
      <% if (it.user) { %>
        <% var _initials = (it.user.full_name || it.user.email || '?').trim().charAt(0).toUpperCase(); %>
        <span class="avatar" aria-hidden="true"><%= _initials %></span>
        <span class="user-name"><%= it.user.full_name || it.user.email %></span>
        <a class="logout" href="/logout">Đăng xuất</a>
      <% } else { %>
        <a class="logout" href="/login">Đăng nhập</a>
      <% } %>
    </div>
  </header>

  <div class="app-shell">
    <!-- Lớp phủ mờ khi mở drawer trên mobile; bấm để đóng (thuần CSS qua label). -->
    <label for="nav-toggle" class="nav-overlay" aria-hidden="true"></label>
    <!-- Thực đơn theo vai trò (DCS-7 §1.2): ẩn hẳn mục không có quyền. -->
    <% var nav = it.nav || {}; %>
    <nav class="sidebar" aria-label="Điều hướng chính">
      <ul>
        <li class="sidebar-group">Không gian chung</li>
        <li><a href="/">Trang chủ</a></li>
        <% if (nav.inDocFlow) { %><li><a href="/documents">Danh mục tài liệu</a></li><% } %>
        <% if (nav.canSeeMyDocuments) { %><li><a href="/my-documents">Tài liệu của tôi</a></li><% } %>
        <% if (nav.inDocFlow) { %>
        <li class="sidebar-group">Quy trình</li>
        <% if (nav.isSiteDocControl) { %><li><a href="/site-receipts">Chờ site phản hồi</a></li><% } %>
        <% if (nav.isSiteDocControl) { %><li><a href="/issue-reports">Báo bất thường (site)</a></li><% } %>
        <% if (nav.canRegister) { %><li><a href="/reviews">Xem xét định kỳ</a></li><% } %>
        <% if (nav.canRegister) { %><li><a href="/packages">Gói ban hành</a></li><% } %>
        <% } %>
        <% if (nav.isAdmin) { %>
        <li class="sidebar-group">Quản trị</li>
        <li><a href="/functional-groups">Nhóm chức năng</a></li>
        <li><a href="/admin/org">Quản trị tổ chức</a></li>
        <li><a href="/admin/users">Quản trị người dùng</a></li>
        <li><a href="/admin/roles">Vai trò</a></li>
        <li class="sidebar-group">Hệ thống</li>
        <li><a href="/audit">Ghi vết</a></li>
        <% } %>
      </ul>
      <p class="phase-note">Giai đoạn 1 — L1 chưa vận hành</p>
    </nav>

    <main class="content">
      <%~ it.body %>
    </main>
  </div>
</body>
</html>
