<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title || 'DCS — Quản lý & Phân phối Tài liệu' %></title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
  <!-- Thanh điều hướng (DCS-7 §1.1) -->
  <header class="topbar">
    <div class="topbar-left">
      <a class="brand" href="/">DCS</a>
      <form class="search" action="/search" method="get" role="search" autocomplete="off">
        <input type="search" name="q" placeholder="Tìm số hiệu, tiêu đề, nội dung…" aria-label="Tìm kiếm"
               hx-get="/search/suggest" hx-trigger="keyup changed delay:250ms" hx-target="#suggest-box" hx-swap="innerHTML">
        <div id="suggest-box" class="suggest-box"></div>
      </form>
    </div>
    <div class="topbar-right">
      <% if (it.user) { %>
        <span class="user-name"><%= it.user.full_name || it.user.email %></span>
        <a class="logout" href="/logout">Đăng xuất</a>
      <% } else { %>
        <a class="logout" href="/login">Đăng nhập</a>
      <% } %>
    </div>
  </header>

  <div class="app-shell">
    <!-- Thực đơn theo vai trò (DCS-7 §1.2): ẩn hẳn mục không có quyền. -->
    <% var nav = it.nav || {}; %>
    <nav class="sidebar" aria-label="Điều hướng chính">
      <ul>
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/documents">Danh mục tài liệu</a></li>
        <li><a href="/qa">Hỏi đáp (thử nghiệm)</a></li>
        <% if (nav.canRegister) { %><li><a href="/my-documents">Tài liệu của tôi</a></li><% } %>
        <% if (nav.canRelease) { %><li><a href="/pending-confirmation">Chờ tôi xác nhận</a></li><% } %>
        <% if (nav.canRelease) { %><li><a href="/reviews">Rà soát định kỳ</a></li><% } %>
        <% if (nav.canRegister || nav.canRelease) { %><li><a href="/packages">Gói ban hành</a></li><% } %>
        <% if (nav.canRelease) { %><li><a href="/functional-groups">Nhóm chức năng</a></li><% } %>
        <% if (nav.isAdmin) { %><li><a href="/admin/org">Quản trị tổ chức</a></li><% } %>
        <% if (nav.isAdmin) { %><li><a href="/admin/users">Quản trị người dùng</a></li><% } %>
        <% if (nav.isAdmin) { %><li><a href="/admin/roles">Vai trò</a></li><% } %>
        <% if (nav.canRelease) { %><li><a href="/ops/quality">Chất lượng nạp</a></li><% } %>
        <% if (nav.canRelease) { %><li><a href="/ops/usage">Mức độ sử dụng</a></li><% } %>
        <% if (nav.canRelease) { %><li><a href="/audit">Ghi vết</a></li><% } %>
      </ul>
      <p class="phase-note">Giai đoạn 1 — L1 chưa vận hành</p>
    </nav>

    <main class="content">
      <%~ it.body %>
    </main>
  </div>
</body>
</html>
