<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title || 'DCS — Quản lý & Phân phối Tài liệu' %></title>
  <link rel="stylesheet" href="/static/app.css?v=<%= it.assetVersion %>">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
  <!-- Công tắc drawer điều hướng mobile (thuần CSS, không JS). Ẩn trên desktop;
       chỉ hiện/điều khiển trong @media (max-width:768px). -->
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
  <!-- Thanh điều hướng (DCS-7 §1.1) -->
  <header class="topbar">
    <div class="topbar-left">
      <label for="nav-toggle" class="nav-hamburger" aria-label="Mở menu"><span></span><span></span><span></span></label>
      <span class="brand-wrap">
        <a class="brand" href="/">DCS</a>
        <span class="brand-sub">Document Control System</span>
      </span>
      <form class="search" action="/search" method="get" role="search" autocomplete="off">
        <input type="search" name="q" placeholder="Tìm số hiệu, tiêu đề, nội dung…" aria-label="Tìm kiếm"
               hx-get="/search/suggest" hx-trigger="keyup changed delay:250ms" hx-target="#suggest-box" hx-swap="innerHTML">
        <div id="suggest-box" class="suggest-box"></div>
      </form>
    </div>
    <div class="topbar-right">
      <% if (it.user) { %>
        <% var _initials = (it.user.full_name || it.user.email || '?').trim().charAt(0).toUpperCase(); %>
        <span class="avatar" aria-hidden="true"><%= _initials %></span>
        <span class="user-name"><%= it.user.full_name || it.user.email %></span>
        <a class="logout" href="/logout">Đăng xuất</a>
      <% } else { %>
        <a class="logout" href="/login">Đăng nhập</a>
      <% } %>
    </div>
  </header>

  <div class="app-shell">
    <!-- Lớp phủ mờ khi mở drawer trên mobile; bấm để đóng (thuần CSS qua label). -->
    <label for="nav-toggle" class="nav-overlay" aria-hidden="true"></label>
    <!-- Thực đơn theo vai trò (DCS-7 §1.2): ẩn hẳn mục không có quyền. -->
    <% var nav = it.nav || {}; %>
    <nav class="sidebar" aria-label="Điều hướng chính">
<%
function icon(k){
  switch(k){
  case 'home': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 11l9-8 9 8\"/><path d=\"M5 10v10h14V10\"/></svg>";
  case 'catalog': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><path d=\"M8 7h8M8 11h8M8 15h5\"/></svg>";
  case 'mydocs': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 3h8l4 4v14H6z\"/><path d=\"M14 3v4h4\"/><path d=\"M9 13h6M9 17h6\"/></svg>";
  case 'pending': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>";
  case 'report': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l9 16H3z\"/><path d=\"M12 10v4M12 17h.01\"/></svg>";
  case 'review': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>";
  case 'package': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7l9-4 9 4-9 4-9-4z\"/><path d=\"M3 7v10l9 4 9-4V7\"/><path d=\"M12 11v10\"/></svg>";
  case 'groups': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 20a6 6 0 0 1 12 0\"/><path d=\"M16 6a3 3 0 0 1 0 6\"/><path d=\"M18 20a6 6 0 0 0-3-5\"/></svg>";
  case 'org': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"9\" width=\"16\" height=\"11\" rx=\"1\"/><path d=\"M8 9V5h8v4M12 13v3\"/></svg>";
  case 'users': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"3.5\"/><path d=\"M5 20a7 7 0 0 1 14 0\"/></svg>";
  case 'roles': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l7 3v5c0 4-3 7-7 9-4-2-7-5-7-9V6z\"/></svg>";
  case 'audit': return "<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 5h6M9 5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2\"/><path d=\"M9 11l1.5 1.5L13 10\"/><path d=\"M14 16h2\"/></svg>";
    default: return '';
  }
}
%>
      <ul>
        <li class="sidebar-group">Không gian chung</li>
        <li><a href="/"><span class="nav-ic"><%~ icon('home') %></span><span class="nav-label">Trang chủ</span></a></li>
        <% if (nav.inDocFlow) { %><li><a href="/documents"><span class="nav-ic"><%~ icon('catalog') %></span><span class="nav-label">Danh mục tài liệu</span></a></li><% } %>
        <% if (nav.canSeeMyDocuments) { %><li><a href="/my-documents"><span class="nav-ic"><%~ icon('mydocs') %></span><span class="nav-label">Tài liệu của tôi</span></a></li><% } %>
        <% if (nav.inDocFlow) { %>
        <li class="sidebar-group">Quy trình</li>
        <% if (nav.isSiteDocControl) { %><li><a href="/site-receipts"><span class="nav-ic"><%~ icon('pending') %></span><span class="nav-label">Chờ site phản hồi</span><% if (nav.pendingReceipts > 0) { %><span class="nav-badge"><%= nav.pendingReceipts %></span><% } %></a></li><% } %>
        <% if (nav.isSiteDocControl) { %><li><a href="/issue-reports"><span class="nav-ic"><%~ icon('report') %></span><span class="nav-label">Báo bất thường (site)</span></a></li><% } %>
        <% if (nav.canRegister || nav.isSiteDocControl) { %><li><a href="/reviews"><span class="nav-ic"><%~ icon('review') %></span><span class="nav-label">Xem xét định kỳ</span></a></li><% } %>
        <% if (nav.canRegister) { %><li><a href="/packages"><span class="nav-ic"><%~ icon('package') %></span><span class="nav-label">Gói ban hành</span></a></li><% } %>
        <% } %>
        <% if (nav.isAdmin) { %>
        <li class="sidebar-group">Quản trị</li>
        <li><a href="/functional-groups"><span class="nav-ic"><%~ icon('groups') %></span><span class="nav-label">Nhóm chức năng</span></a></li>
        <li><a href="/admin/org"><span class="nav-ic"><%~ icon('org') %></span><span class="nav-label">Quản trị tổ chức</span></a></li>
        <li><a href="/admin/users"><span class="nav-ic"><%~ icon('users') %></span><span class="nav-label">Quản trị người dùng</span></a></li>
        <li><a href="/admin/roles"><span class="nav-ic"><%~ icon('roles') %></span><span class="nav-label">Vai trò</span></a></li>
        <li class="sidebar-group">Hệ thống</li>
        <li><a href="/audit"><span class="nav-ic"><%~ icon('audit') %></span><span class="nav-label">Ghi vết</span></a></li>
        <% } %>
      </ul>
      <p class="phase-note">Giai đoạn 1 — L1 chưa vận hành</p>
    </nav>

    <main class="content">
      <%~ it.body %>
    </main>
  </div>
  <!-- Vùng cảnh báo tại chỗ: htmx chèn toast lỗi nghiệp vụ vào đây. -->
  <div id="toast-zone" class="toast-zone" aria-live="polite"></div>
  <script>
  // htmx mặc định KHÔNG swap với 4xx/5xx. Cho phép swap nội dung lỗi nghiệp vụ (4xx).
  document.body.addEventListener('htmx:beforeSwap', function (evt) {
    var st = evt.detail.xhr.status;
    if (st >= 400 && st < 500) { evt.detail.shouldSwap = true; evt.detail.isError = false; }
  });
  </script>
</body>
</html>
