<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tra cứu bản in — DCS</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body class="verify-page">
  <% var r = it.result; %>
  <!-- Trang tra cứu QR (DCS-7 §7.5): kết quả chiếm trọn màn hình, đọc cách 1m,
       tối đa một câu. KHÔNG hiện nội dung tài liệu, nhãn, người nhận. -->
  <% if (!r.found) { %>
    <main class="verify-card verify-unknown">
      <div class="verify-big">?</div>
      <p>Không tìm thấy bản in này.</p>
    </main>
  <% } else if (r.status === 'con_hieu_luc') { %>
    <main class="verify-card verify-ok">
      <div class="verify-big">✓</div>
      <p>Bản này CÒN HIỆU LỰC.</p>
    </main>
  <% } else { %>
    <main class="verify-card verify-bad">
      <div class="verify-big">✗</div>
      <% if (r.status === 'het_hieu_luc') { %>
        <p>Bản này ĐÃ HẾT HIỆU LỰC<% if (r.currentVersionNo) { %> — bản mới nhất là phiên bản <%= r.currentVersionNo %><% } %>.</p>
      <% } else if (r.status === 'thu_hoi') { %>
        <p>Tài liệu này ĐÃ THU HỒI.</p>
      <% } else if (r.status === 'ban_in_thu_hoi') { %>
        <p>Bản in này ĐÃ ĐƯỢC THU HỒI.</p>
      <% } else { %>
        <p>Không xác định được tình trạng — hỏi người phụ trách tài liệu.</p>
      <% } %>
    </main>
  <% } %>
</body>
</html>
