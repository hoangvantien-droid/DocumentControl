<!-- Mảnh cho form thêm ma trận phân phối trên trang chi tiết -->
<form method="post" action="/documents/<%= it.id %>/matrix/add" class="inline-form">
  <select name="department_id" required>
    <option value="">-- bộ phận (bắt buộc) --</option>
    <% it.depts.forEach(function(d){ %><option value="<%= d.dept_id %>"><%= d.dept_code %></option><% }) %>
  </select>
  <select name="functional_group_id">
    <option value="">(nhóm chức năng — tuỳ chọn, lấy phép giao)</option>
    <% it.groups.forEach(function(g){ %><option value="<%= g.group_id %>"><%= g.code %></option><% }) %>
  </select>
  <button type="submit">Thêm phân phối</button>
</form>
