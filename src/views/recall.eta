<% layout('layout.eta', { title: 'Thu hồi — DCS', user: it.user }) %>
<% var d = it.d; %>

<h1>Thu hồi: <%= d.doc_id %> v<%= d.version_no %></h1>
<% if (it.error) { %><div class="login-error"><%= it.error %></div><% } %>

<div class="warn-banner">
  Thu hồi dùng khi tài liệu bị huỷ bỏ mà KHÔNG có bản thay thế. Sau khi thu hồi
  không quay lại được. Các đối tượng đang tham chiếu:
  <ul>
    <li>Dòng phân phối: <%= it.impact.distribution_count %></li>
    <li>Bản in đang lưu hành: <%= it.impact.printed_copies_active %></li>
    <li>Nhãn liên kết: <%= it.impact.referencing_links %></li>
  </ul>
</div>

<form method="post" action="/documents/<%= d.version_id %>/recall" class="reject-form">
  <input name="reason" placeholder="Lý do thu hồi (bắt buộc)" required>
  <button type="submit" class="danger">Xác nhận thu hồi</button>
</form>
