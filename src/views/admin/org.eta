<% layout('/layout.eta', { title: 'Quản trị tổ chức — DCS', user: it.user }) %>

<!-- DCS là nguồn sở hữu tổ chức. Mỗi thay đổi phải được rà soát trong dashboard sức khoẻ tổ chức. -->
<div class="warn-banner">
  DCS sở hữu cây tổ chức. Site có thể phục vụ nhiều BU; hãy duy trì quan hệ này khi tổ chức thay đổi.
</div>

<div class="page-header">
  <div class="page-header__titles">
    <h1>Quản trị tổ chức</h1>
    <p class="page-header__desc">Cây tổ chức: khối (BU), nhà máy/site, bộ phận. DCS là nguồn sở hữu.</p>
  </div>
</div>

<% if (it.error) { %><div class="login-error"><%= it.error %></div><% } %>

<section class="org-grid">
  <div class="org-col">
    <h2>Ngành hàng (BU)</h2>
    <ul>
      <% it.bus.forEach(function(b){ %><li><b><%= b.bu_code %></b> — <%= b.name %></li><% }) %>
    </ul>
    <form method="post" action="/admin/org/bu" class="inline-form">
      <input name="code" placeholder="Mã BU" required>
      <input name="name" placeholder="Tên" required>
      <button type="submit">Thêm BU</button>
    </form>
  </div>

  <div class="org-col">
    <h2>Nhà máy (Site)</h2>
    <ul>
      <% it.sites.forEach(function(s){ %><li><b><%= s.site_code %></b> — <%= s.name %></li><% }) %>
    </ul>
    <form method="post" action="/admin/org/site" class="inline-form">
      <input name="code" placeholder="Mã Site" required>
      <input name="name" placeholder="Tên" required>
      <select name="bu_id" required>
        <option value="">-- BU --</option>
        <% it.bus.forEach(function(b){ %><option value="<%= b.bu_id %>"><%= b.bu_code %></option><% }) %>
      </select>
      <button type="submit">Thêm Site</button>
    </form>
    <form method="post" action="/admin/org/site-bu" class="inline-form">
      <select name="site_id" required>
        <option value="">-- Site --</option>
        <% it.sites.forEach(function(s){ %><option value="<%= s.site_id %>"><%= s.site_code %></option><% }) %>
      </select>
      <select name="bu_id" required>
        <option value="">-- Gán thêm BU --</option>
        <% it.bus.forEach(function(b){ %><option value="<%= b.bu_id %>"><%= b.bu_code %></option><% }) %>
      </select>
      <button type="submit">Gán BU cho Site</button>
    </form>
  </div>

  <div class="org-col">
    <h2>Phòng ban (Department)</h2>
    <ul>
      <% it.depts.forEach(function(d){ %><li><b><%= d.dept_code %></b> — <%= d.name %></li><% }) %>
    </ul>
    <form method="post" action="/admin/org/dept" class="inline-form">
      <input name="code" placeholder="Mã Dept" required>
      <input name="name" placeholder="Tên" required>
      <select name="site_id" required>
        <option value="">-- Site --</option>
        <% it.sites.forEach(function(s){ %><option value="<%= s.site_id %>"><%= s.site_code %></option><% }) %>
      </select>
      <button type="submit">Thêm Dept</button>
    </form>
  </div>
</section>
