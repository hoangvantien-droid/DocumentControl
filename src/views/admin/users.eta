<% layout('layout.eta', { title: 'Quản trị người dùng — DCS', user: it.user }) %>

<div class="warn-banner">
  Người dùng khai tay chỉ dùng khi L1 chưa vận hành. Khi L1 lên, người dùng đồng bộ tự động.
</div>

<h1>Quản trị người dùng</h1>
<% if (it.error) { %><div class="login-error"><%= it.error %></div><% } %>

<table class="data-table">
  <thead><tr><th>Họ tên</th><th>Email</th><th>Trạng thái</th><th>Bộ phận</th><th>Thao tác</th></tr></thead>
  <tbody>
    <% it.users.forEach(function(u){ %>
    <tr>
      <td><%= u.full_name %></td>
      <td><%= u.email %></td>
      <td><%= u.is_active ? 'Hoạt động' : 'Ngừng' %></td>
      <td>
        <% (it.deptsByUser[u.user_id] || []).forEach(function(did){
             var d = it.depts.find(function(x){return x.dept_id===did}); %>
          <span class="chip"><%= d ? d.dept_code : did %></span>
        <% }) %>
      </td>
      <td>
        <form method="post" action="/admin/users/assign-dept" class="inline-form">
          <input type="hidden" name="user_id" value="<%= u.user_id %>">
          <select name="dept_id" required>
            <option value="">-- gán bộ phận --</option>
            <% it.depts.forEach(function(d){ %><option value="<%= d.dept_id %>"><%= d.dept_code %></option><% }) %>
          </select>
          <button type="submit">Gán</button>
        </form>
        <form method="post" action="/admin/users/active" class="inline-form">
          <input type="hidden" name="user_id" value="<%= u.user_id %>">
          <input type="hidden" name="active" value="<%= u.is_active ? 'false' : 'true' %>">
          <button type="submit"><%= u.is_active ? 'Ngừng' : 'Bật lại' %></button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<h2>Thêm người dùng</h2>
<form method="post" action="/admin/users" class="inline-form">
  <input name="full_name" placeholder="Họ tên" required>
  <input name="email" type="email" placeholder="Email" required>
  <input name="password" type="password" placeholder="Mật khẩu (≥8)" required>
  <button type="submit">Tạo</button>
</form>
