<% layout('layout.eta', { title: 'Đăng ký tài liệu — DCS', user: it.user }) %>
<% var val = it.values || {}; %>

<h1>Đăng ký tài liệu ban hành</h1>
<% if (it.error) { %><div class="login-error"><%= it.error %></div><% } %>

<form method="post" action="/register" class="reg-form" enctype="multipart/form-data">
  <fieldset>
    <legend>Định danh &amp; phạm vi</legend>
    <label>Số hiệu tài liệu
      <input name="doc_id" required value="<%= val.doc_id || '' %>" placeholder="MML/QA/HD-005">
    </label>
    <label>Loại
      <select name="doc_type">
        <% ['SOP','WI','Form','Policy','External'].forEach(function(t){ %>
          <option value="<%= t %>" <%= val.doc_type===t?'selected':'' %>><%= t %></option>
        <% }) %>
      </select>
    </label>
    <label>Nguồn
      <select name="origin">
        <option value="noi_bo" <%= val.origin==='noi_bo'?'selected':'' %>>Nội bộ</option>
        <option value="ngoai_bo" <%= val.origin==='ngoai_bo'?'selected':'' %>>Ngoại bộ</option>
      </select>
    </label>
    <label>Cấp phạm vi
      <select name="scope_level">
        <% ['group','bu','site','dept'].forEach(function(s){ %>
          <option value="<%= s %>" <%= val.scope_level===s?'selected':'' %>><%= s %></option>
        <% }) %>
      </select>
    </label>
    <label>BU (nếu cấp bu)
      <select name="scope_bu_id"><option value="">--</option>
        <% it.bus.forEach(function(x){ %><option value="<%= x.bu_id %>"><%= x.bu_code %></option><% }) %>
      </select>
    </label>
    <label>Site (nếu cấp site)
      <select name="scope_site_id"><option value="">--</option>
        <% it.sites.forEach(function(x){ %><option value="<%= x.site_id %>"><%= x.site_code %></option><% }) %>
      </select>
    </label>
    <label>Department (nếu cấp dept)
      <select name="scope_dept_id"><option value="">--</option>
        <% it.depts.forEach(function(x){ %><option value="<%= x.dept_id %>"><%= x.dept_code %></option><% }) %>
      </select>
    </label>
    <label>Tệp PDF của tài liệu
      <input type="file" name="file" accept="application/pdf" required>
    </label>
  </fieldset>

  <fieldset>
    <legend>Hồ sơ phê duyệt &amp; hiệu lực</legend>
    <label>Phiên bản <input name="version_no" required value="<%= val.version_no || '' %>" placeholder="1.0"></label>
    <label>Tiêu đề <input name="title" required value="<%= val.title || '' %>"></label>
    <label>Ngày ban hành <input type="date" name="issued_date" required value="<%= val.issued_date || '' %>"></label>
    <label>Người phê duyệt / tổ chức phát hành <input name="approver_name" required value="<%= val.approver_name || '' %>"></label>
    <label>Số hồ sơ phê duyệt (nội bộ) <input name="approval_reference" value="<%= val.approval_reference || '' %>"></label>
    <label>Hình thức phê duyệt
      <select name="approval_method">
        <option value="ky_so">Ký số</option>
        <option value="ky_tay_so_hoa">Ký tay số hoá</option>
        <option value="thu_dien_tu_luu_vet">Thư điện tử có lưu vết</option>
      </select>
    </label>
    <label>Ngày hiệu lực pháp lý (ngoại bộ) <input type="date" name="external_effective_date" value="<%= val.external_effective_date || '' %>"></label>
    <label>Ngày hiệu lực (DCS) <input type="date" name="effective_date" required value="<%= val.effective_date || '' %>"></label>
    <label>Chu kỳ rà soát (tháng) <input type="number" name="review_cycle_months" value="<%= val.review_cycle_months || '12' %>" min="1"></label>
    <label>Ngày hết hạn (tuỳ chọn) <input type="date" name="expiry_date" value="<%= val.expiry_date || '' %>"></label>
    <label>Bộ phận sở hữu
      <select name="owner_department_id" required
              hx-get="/register/recipient-count" hx-trigger="change"
              hx-target="#recip-count" hx-swap="innerHTML"
              hx-params="owner_department_id">
        <option value="">--</option>
        <% it.depts.forEach(function(x){ %><option value="<%= x.dept_id %>"><%= x.dept_code %></option><% }) %>
      </select>
    </label>
    <div id="recip-count" class="recip-count muted"></div>
  </fieldset>

  <fieldset>
    <legend>Phiên bản mới (nếu thay thế bản cũ)</legend>
    <label>version_id bản gốc (supersedes) <input name="supersedes_version_id" value="<%= val.supersedes_version_id || '' %>"></label>
    <label>Mức độ thay đổi
      <select name="change_significance"><option value="">--</option>
        <option value="lon">Lớn</option><option value="nho">Nhỏ</option>
      </select>
    </label>
    <label>Tóm tắt thay đổi (bắt buộc nếu lớn) <input name="change_summary" value="<%= val.change_summary || '' %>"></label>
  </fieldset>

  <fieldset>
    <legend>Nhãn liên kết (bắt buộc ít nhất một)</legend>
    <label>Loại nhãn
      <select name="link_type">
        <option value="dieu_khoan">Điều khoản</option>
        <option value="cong_doan">Công đoạn</option>
        <option value="diem_kiem_soat">Điểm kiểm soát</option>
        <option value="moi_nguy">Mối nguy</option>
        <option value="tai_lieu">Tài liệu</option>
      </select>
    </label>
    <label>Mã liên kết <input name="link_code" placeholder="BRC-9-5.6.2"></label>
  </fieldset>

  <button type="submit" class="primary">Nộp đăng ký</button>
  <button type="submit" class="btn-diff" formaction="/register/draft">Lưu nháp</button>
</form>
