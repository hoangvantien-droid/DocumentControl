<% layout('layout.eta', { title: 'Kiểm tra dữ liệu nhập — DCS', user: it.user }) %>

<h1>Kiểm tra dữ liệu nhập</h1>
<p class="muted">Read-only — không đổi trạng thái tài liệu. Checklist tự động giống trang xác nhận.</p>

<% if (it.items.length === 0) { %>
  <p>Không có bản nháp hoặc bản chờ xác nhận nào.</p>
<% } %>

<% it.items.forEach(function(item){ %>
  <section class="card" style="margin-bottom: 20px;">
    <h2><%= item.version.doc_id %> — phiên bản <%= item.version.version_no %></h2>
    <p><%= item.version.title %></p>
    <p>
      <span class="status status-<%= item.version.status %>"><%= item.version.status %></span>
      <span class="muted"> | Loại: <%= item.version.doc_type %></span>
      <% if (item.version.effective_date) { %>
        <span class="muted"> | Hiệu lực: <%= item.version.effective_date %></span>
      <% } %>
    </p>

    <h3>Checklist tự động</h3>
    <ul class="check-list">
      <% item.checklist.forEach(function(c){ %>
        <li class="check-item check-<%= c.kind %> level-<%= c.level %>">
          <span class="check-no"><%= c.no %></span>
          <% if (c.kind === 'auto') { %>
            <span class="check-mark <%= c.pass ? 'ok' : 'fail' %>"><%= c.pass ? '✓' : '✕' %></span>
            <span class="check-label"><%= c.label %></span>
            <% if (c.note) { %><small class="check-note"><%= c.note %></small><% } %>
          <% } else { %>
            <span class="check-mark warn">!</span>
            <span class="check-label"><%= c.label %></span>
            <small class="check-note">(cần người kiểm)</small>
          <% } %>
        </li>
      <% }) %>
    </ul>

    <% if (item.version.status === 'cho_hoan_thien') { %>
      <p><a href="/my-documents/<%= item.version.version_id %>/edit">Sửa nháp</a></p>
    <% } %>
  </section>
<% }) %>
