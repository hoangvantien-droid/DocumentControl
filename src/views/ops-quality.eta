<% layout('layout.eta', { title: 'Chất lượng nạp — DCS', user: it.user }) %>
<% var r = it.report; %>

<h1>Báo cáo chất lượng sau nạp</h1>
<p class="muted">Bốn kiểm tra nên chạy trước khi tuyên bố hoàn tất nạp (DCS-6 §5).</p>

<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-num"><%= r.totalEffective %></div>
    <div class="metric-label">Tài liệu đang hiệu lực</div>
  </div>
  <div class="metric-card <%= r.sectionLevelLinkRatio < 20 ? 'metric-bad' : '' %>">
    <div class="metric-num"><%= r.sectionLevelLinkRatio %>%</div>
    <div class="metric-label">Có nhãn liên kết cấp mục<br><small>Gần 0% = khai cho có, mất phần lớn giá trị</small></div>
  </div>
  <div class="metric-card <%= r.poorParseRatio > 20 ? 'metric-bad' : '' %>">
    <div class="metric-num"><%= r.poorParseRatio %>%</div>
    <div class="metric-label">Bóc tách kém tin cậy<br><small>Trên 20% = chất lượng số hoá kém</small></div>
  </div>
</div>

<h2>Phân bố nhãn điều khoản (top 10)</h2>
<p class="muted">Một mã gắn vào quá nhiều tài liệu là dấu hiệu khai quá rộng cho chắc ăn.</p>
<table class="data-table">
  <thead><tr><th>Mã điều khoản</th><th>Số tài liệu viện dẫn</th></tr></thead>
  <tbody>
    <% it.report.topLinkCodes.forEach(function(c){ %>
      <tr><td><%= c.link_code %></td><td class="<%= c.doc_count >= 30 ? 'metric-bad-text' : '' %>"><%= c.doc_count %></td></tr>
    <% }) %>
    <% if (it.report.topLinkCodes.length === 0) { %><tr><td colspan="2">Chưa có nhãn điều khoản.</td></tr><% } %>
  </tbody>
</table>
