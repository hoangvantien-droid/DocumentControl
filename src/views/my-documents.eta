<% layout('layout.eta', { title: 'Tài liệu của tôi — DCS', user: it.user }) %>

<div class="page-header">
  <div class="page-header__titles">
    <h1>Tài liệu của tôi</h1>
    <p class="page-header__desc">Tài liệu bạn đăng ký. Theo dõi trạng thái tiếp nhận của site và tình trạng ban hành.</p>
  </div>
  <div class="toolbar">
    <% if (it.nav && it.nav.canRegister) { %>
      <a href="/register" class="btn-action btn-action--primary"><%~ include('/components/action-icon.eta', { name: 'plus' }) %> Đăng ký tài liệu</a>
    <% } %>
  </div>
</div>

<table class="data-table responsive-table">
  <thead><tr><th>Số hiệu tài liệu</th><th>Phiên bản</th><th>Tiêu đề</th><th>Trạng thái</th><th>Site xác nhận</th><th>Tình trạng ban hành</th><th>Thao tác</th></tr></thead>
  <tbody>
    <% it.docs.forEach(function(d){ %>
    <tr>
      <td data-label="Số hiệu tài liệu">
        <% if (d.status === 'cho_hoan_thien') { %>
          <%= d.doc_id %>
        <% } else { %>
          <a href="/documents/<%= d.version_id %>"><%= d.doc_id %></a>
        <% } %>
      </td>
      <td data-label="Phiên bản"><%= d.version_no %></td>
      <td data-label="Tiêu đề"><%= d.title %></td>
      <td data-label="Trạng thái"><span class="status status-<%= d.status %>"><%= it.docStatusLabel(d.status) %></span>
        <% if (d.status === 'tu_choi' && d.rejection_reason) { %>
          <div class="reject-reason">Lý do: <%= d.rejection_reason %></div>
        <% } %>
      </td>
      <td data-label="Site xác nhận">
        <% if (d.total > 0) { %><%= d.accepted %>/<%= d.total %><% } else { %><span class="muted">—</span><% } %>
      </td>
      <td data-label="Tình trạng ban hành">
        <% if (d.total > 0) { %>
          <% var disp = it.aggregateDisplay(d.aggregate, d.hasContentReject); %>
          <span class="status <%= disp.cls %>"><%= disp.label %></span>
        <% } else { %><span class="muted">Chưa phát hành</span><% } %>
      </td>
      <td class="row-actions" data-label="Thao tác">
        <% if (d.status === 'da_ban_hanh') { %>
          <a href="/documents/<%= d.version_id %>/view" target="_blank" rel="noopener">Xem PDF</a>
          <a href="/my-documents/<%= d.version_id %>/issuance">Tình trạng</a>
        <% } else if (d.status === 'cho_hoan_thien') { %>
          <a href="/my-documents/<%= d.version_id %>/edit">Sửa nháp</a>
        <% } else if (d.total > 0) { %>
          <a href="/my-documents/<%= d.version_id %>/issuance">Tình trạng</a>
        <% } %>
      </td>
    </tr>
    <% }) %>
    <% if (it.docs.length === 0) { %><tr><td colspan="7" data-label="">Chưa có tài liệu nào.</td></tr><% } %>
  </tbody>
</table>
