<% layout('layout.eta', { title: 'Báo bất thường — DCS', user: it.user }) %>

<h1>Báo bất thường từ người đọc</h1>

<% if (it.notControl) { %>
  <div class="alert-banner alert-banner--info"><strong>Thông tin:</strong> Bạn chưa được gán vai Kiểm soát tài liệu cho site nào.</div>
<% } else { %>
  <p class="muted">Report do người đọc trong site gửi lên. Thẩm định rồi chuyển thành phản hồi từ chối tới người đăng ký, hoặc bác bỏ nếu không hợp lệ.</p>

  <% if (it.reports.length === 0) { %>
    <%~ include('/components/empty-state.eta', { text: 'Không có report nào chờ thẩm định.' }) %>
  <% } %>

  <div class="report-list">
    <% it.reports.forEach(function(r){ %>
    <article class="report-card">
      <div class="report-card__head">
        <a class="report-card__doc" href="/documents/<%= r.version_id %>"><%= r.doc_id %> v<%= r.version_no %></a>
        <span class="report-card__title"><%= r.title %></span>
      </div>
      <div class="report-card__meta">
        Site <%= r.site_code %> · người báo <%= r.reporter_name || r.reported_by %> · <%= (r.created_at || '').slice(0,10) %>
      </div>
      <blockquote class="report-card__note"><%= r.note %></blockquote>

      <div class="report-card__actions">
        <form method="post" action="/issue-reports/<%= r.report_id %>/convert" class="report-form" hx-post="/issue-reports/<%= r.report_id %>/convert" hx-target="#toast-zone" hx-swap="beforeend">
          <div class="report-form__title">Chuyển thành phản hồi từ chối</div>
          <label>Loại sai sót
            <select name="reject_type" required>
              <option value="sai_dang_ky">Sai thông tin đăng ký</option>
              <option value="sai_noi_dung">Sai nội dung tài liệu</option>
            </select>
          </label>
          <label>Ghi chú (tuỳ chọn)
            <input name="note" placeholder="Bổ sung cho người đăng ký">
          </label>
          <button type="submit" class="primary">Chuyển thành từ chối</button>
        </form>

        <form method="post" action="/issue-reports/<%= r.report_id %>/dismiss" class="report-form" hx-post="/issue-reports/<%= r.report_id %>/dismiss" hx-target="#toast-zone" hx-swap="beforeend">
          <div class="report-form__title">Bác bỏ report</div>
          <label>Lý do bác bỏ <span class="req">*</span>
            <input name="review_note" required placeholder="Vì sao không chuyển">
          </label>
          <button type="submit" class="btn-diff">Bác bỏ</button>
        </form>
      </div>
    </article>
    <% }) %>
  </div>
<% } %>
