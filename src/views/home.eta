<% layout('layout.eta', { title: 'Trang chủ — DCS', user: it.user }) %>

<!-- Trang chủ: hôm nay tôi cần làm gì. Khối không có việc thì ẩn hẳn. -->
<section class="home">
  <div class="page-header">
    <div class="page-header__titles">
      <h1>Xin chào<%= it.user && it.user.full_name ? ', ' + it.user.full_name : '' %></h1>
      <p class="page-header__desc">Hôm nay bạn cần làm gì. Các khối việc không có sẽ tự ẩn.</p>
    </div>
  </div>

  <div class="quick-search">
    <form action="/documents" method="get" role="search">
      <input type="search" name="q" placeholder="Tìm tài liệu…" aria-label="Tìm kiếm nhanh">
      <button type="submit">Mở danh mục</button>
    </form>
  </div>

  <% if (it.pendingReceipts && it.pendingReceipts.length > 0) { %>
    <div class="home-block">
      <h2>Chờ site bạn phản hồi (<%= it.pendingReceipts.length %>)</h2>
      <ul class="home-list">
        <% it.pendingReceipts.forEach(function(r){ %>
          <li>
            <a href="/site-receipts/<%= r.receipt_id %>"><%= r.doc_id %> v<%= r.version_no %> — <%= r.title %></a>
            <span class="muted"> · site <%= r.site_code %></span>
            <% if (r.other_reject_type === 'sai_noi_dung') { %> · <span class="status status-thu_hoi">site khác báo sai nội dung</span><% } %>
          </li>
        <% }) %>
      </ul>
      <p><a href="/site-receipts" class="btn-link">Xem tất cả</a></p>
    </div>
  <% } %>

  <% if (it.rejectedMine && it.rejectedMine.length > 0) { %>
    <div class="home-block">
      <h2>Tài liệu của bạn bị site báo sai sót (<%= it.rejectedMine.length %>)</h2>
      <ul class="home-list">
        <% it.rejectedMine.forEach(function(r){ %>
          <li><a href="/my-documents/<%= r.version_id %>/issuance"><%= r.doc_id %> v<%= r.version_no %> — <%= r.title %></a></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if ((!it.pendingReceipts || it.pendingReceipts.length===0) && (!it.rejectedMine || it.rejectedMine.length===0)) { %>
    <p class="build-note">Không có việc nào cần bạn xử lý hôm nay.</p>
  <% } %>
</section>
