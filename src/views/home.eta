<% layout('layout.eta', { title: 'Trang chủ — DCS', user: it.user }) %>

<!-- Trang chủ (DCS-7 §1.3): hôm nay tôi cần làm gì. Khối không có việc thì ẩn hẳn. -->
<section class="home">
  <h1>Xin chào<%= it.user && it.user.full_name ? ', ' + it.user.full_name : '' %></h1>

  <div class="quick-search">
    <form action="/documents" method="get" role="search">
      <input type="search" name="q" placeholder="Tìm tài liệu…" aria-label="Tìm kiếm nhanh">
      <button type="submit">Mở danh mục</button>
    </form>
  </div>

  <% if (it.pending && it.pending.length > 0) { %>
    <div class="home-block">
      <h2>Việc chờ tôi phê duyệt (<%= it.pending.length %>)</h2>
      <ul class="home-list">
        <% it.pending.forEach(function(p){ %>
          <li><a href="/confirm/<%= p.version_id %>"><%= p.doc_id %> v<%= p.version_no %> — <%= p.title %></a></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (it.rejected && it.rejected.length > 0) { %>
    <div class="home-block">
      <h2>Tài liệu của tôi bị từ chối (<%= it.rejected.length %>)</h2>
      <ul class="home-list">
        <% it.rejected.forEach(function(r){ %>
          <li>
            <a href="/register"><%= r.doc_id %> v<%= r.version_no %> — <%= r.title %></a>
            <div class="reject-reason">Lý do: <%= r.rejection_reason %></div>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if ((!it.pending || it.pending.length===0) && (!it.rejected || it.rejected.length===0)) { %>
    <p class="build-note">Hôm nay bạn chưa có việc nào cần xử lý.</p>
  <% } %>
</section>
