<% layout('layout.eta', { title: 'Xác nhận — DCS', user: it.user }) %>
<% var v = it.v; %>

<h1>Xác nhận: <%= v.doc_id %> — phiên bản <%= v.version_no %></h1>
<p class="doc-title"><%= v.title %></p>

<!-- Thông tin đăng ký để dept head đối chiếu đúng/sai trước khi duyệt -->
<div class="confirm-meta">
  <dl>
    <dt>Loại / Nguồn</dt><dd><%= v.doc_type %> / <%= v.origin %></dd>
    <dt>Phạm vi</dt><dd><%= v.scope_level %><% if (v.scope_dept_code) { %> · <%= v.scope_dept_code %> — <%= v.scope_dept_name %><% } else if (v.scope_site_code) { %> · <%= v.scope_site_code %> — <%= v.scope_site_name %><% } else if (v.scope_bu_code) { %> · <%= v.scope_bu_code %> — <%= v.scope_bu_name %><% } %></dd>
    <dt>Người nộp</dt><dd><%= v.registrant_name || '' %> (<%= v.registrant_email || '' %>)</dd>
    <dt>Bộ phận sở hữu</dt><dd><% if (v.owner_dept_code) { %><%= v.owner_dept_code %> — <%= v.owner_dept_name %><% } else { %>—<% } %></dd>
    <dt>Ngày ban hành / hiệu lực / hết hạn</dt><dd><%= v.issued_date || '' %> / <%= v.effective_date || '' %> / <%= v.expiry_date || '' %></dd>
    <dt>Bóc tách</dt><dd><%= v.parse_status %><% if (v.parse_note) { %> — <%= v.parse_note %><% } %><% if (v.file_page_count) { %> · <%= v.file_page_count %> trang<% } %></dd>
    <% if (v.supersedes_version_id) { %>
    <dt>Thay đổi</dt><dd><%= v.change_significance || '' %><% if (v.change_summary) { %> — <%= v.change_summary %><% } %></dd>
    <% } %>
  </dl>
</div>

<% if (it.sections && it.sections.length > 0) { %>
<div class="confirm-sections">
  <h2>Nội dung bóc tách (<%= it.sections.length %> mục)</h2>
  <% it.sections.forEach(function(s){ %>
    <div class="section-block"><h3><%= s.section_code %> <%= s.section_title %></h3><p><%= s.raw_text || '' %></p></div>
  <% }) %>
</div>
<% } else { %>
<div class="confirm-sections"><h2>Nội dung bóc tách</h2><p class="muted">Chưa bóc tách được — kiểm tra mục 5 checklist.</p></div>
<% } %>

<% if (it.links && it.links.length > 0) { %>
<div class="confirm-links">
  <h2>Nhãn liên kết (<%= it.links.length %>)</h2>
  <% it.links.forEach(function(l){ %><span class="chip"><%= l.link_type %>: <%= l.link_code %></span><% }) %>
</div>
<% } %>

<% if (!it.allowed) { %>
  <div class="login-error">Bạn không đủ thẩm quyền xác nhận tài liệu này. Hãy tìm người có quyền xác nhận ở cấp phạm vi tương ứng.</div>
<% } %>

<!-- Guard C.4: ngày hiệu lực đã trôi qua -> ẩn nút Xác nhận, chỉ còn Trả về -->
<% if (!it.effectivePassed) { %>
  <%~ include('/components/alert-banner.eta', { type: 'warning', text: 'Ngày hiệu lực đã qua trong lúc chờ xử lý. Không sửa được ngày ở đây — tài liệu sẽ được trả về người đăng ký để chọn lại ngày.' }) %>
<% } %>

<!-- Bố cục hai cột (Yêu cầu 19.1): vùng xem tệp trái, checklist + nút quyết định cột phải. -->
<div class="confirm-layout">
  <!-- Cột trái: vùng xem tệp. Dùng route /documents/:id/preview để dept head đọc PDF
       trước khi duyệt (kể cả bản cho_xac_nhan). Không dùng đường dẫn đĩa vì
       browser không mở được /var/... -->
  <div class="confirm-file">
    <div class="confirm-file__title">Xem tệp PDF</div>
    <% if (v.file_path) { %>
      <embed class="confirm-file__embed" src="/documents/<%= v.version_id %>/preview" type="application/pdf">
      <p class="confirm-file__link"><a href="/documents/<%= v.version_id %>/preview" target="_blank">Mở tệp trong tab mới</a></p>
    <% } else { %>
      <div class="confirm-file__placeholder">Chưa có tệp để hiển thị. Đối chiếu nội dung theo checklist bên phải.</div>
    <% } %>
  </div>

  <!-- Cột phải: checklist + nút quyết định (dính theo cuộn). -->
  <section class="confirm-panel checklist">
    <h2>Checklist xác nhận</h2>
    <form method="post" action="/confirm/<%= v.version_id %>/approve">
      <input type="hidden" name="needs9b" value="<%= v.supersedes_version_id ? 'true' : 'false' %>">

      <!-- Nhóm TỰ ĐỘNG: dấu tự động (Yêu cầu 19.2 / 7). -->
      <h3 class="check-group__title">TỰ ĐỘNG</h3>
      <ul class="check-list">
        <% it.checklist.forEach(function(c){ %>
          <% if (c.kind === 'auto') { %>
            <li class="check-item check-<%= c.kind %> level-<%= c.level %>">
              <span class="check-no"><%= c.no %></span>
              <span class="check-mark <%= c.pass ? 'ok':'fail' %>"><%= c.pass ? '✓' : '✕' %></span>
              <span class="check-label"><%= c.label %></span>
              <% if (c.note) { %><small class="check-note"><%= c.note %></small><% } %>
            </li>
          <% } %>
        <% }) %>
      </ul>

      <!-- Nhóm TỰ ĐỐI CHIẾU: ô tích thật, chữ đậm, nền khác (Yêu cầu 19.2 / 7.3). -->
      <h3 class="check-group__title">TỰ ĐỐI CHIẾU</h3>
      <ul class="check-list">
        <% it.checklist.forEach(function(c){ %>
          <% if (c.kind !== 'auto') { %>
            <!-- Mục Admin tự tích. Nhìn khác hẳn nhóm tự động. Không có nút tích tất cả. -->
            <li class="check-item check-<%= c.kind %> check-item--manual level-<%= c.level %>">
              <span class="check-no"><%= c.no %></span>
              <% if (c.no === '9b' && !it.viewedDiff) { %>
                <label class="check-label admin locked">
                  <input type="checkbox" disabled> <span class="lock-glyph" aria-hidden="true">🔒</span> <b><%= c.label %></b>
                </label>
                <a class="btn-diff" href="/compare?from=<%= v.supersedes_version_id %>&to=<%= v.version_id %>">Xem so sánh trước</a>
              <% } else { %>
                <label class="check-label admin">
                  <input type="checkbox" name="chk<%= c.no %>"> <b><%= c.label %></b>
                </label>
              <% } %>
            </li>
          <% } %>
        <% }) %>
      </ul>

      <% if (it.allowed && it.effectivePassed) { %>
        <button type="submit" class="primary">Xác nhận</button>
      <% } %>
    </form>

    <!-- Từ chối: bắt buộc lý do -->
    <form method="post" action="/confirm/<%= v.version_id %>/reject" class="reject-form">
      <input name="reason" placeholder="Lý do từ chối (bắt buộc)" required>
      <button type="submit" class="danger">Từ chối / Trả về người đăng ký</button>
    </form>
  </section>
</div>
