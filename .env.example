# DCS — biến môi trường. Sao chép thành .env và điền giá trị thật.
# Các biến BẮT BUỘC: thiếu là hệ thống dừng hẳn khi khởi động (DCS-8 §6.1).

# Kết nối PostgreSQL 16
DATABASE_URL=postgres://dcs:dcs@localhost:5432/dcs_dev

# Cơ sở dữ liệu cho kiểm thử — tên PHẢI chứa chữ "test" (constraints.test.ts tự chặn)
DATABASE_URL_TEST=postgres://dcs:dcs@localhost:5432/dcs_test

# Chuỗi ký phiên, tối thiểu 32 ký tự
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-tren-32-ky-tu

# Thư mục lưu tệp PDF gốc (ngoài cơ sở dữ liệu)
FILE_STORAGE_PATH=./files

# Cổng lắng nghe (tùy chọn, mặc định 3000)
PORT=3000

# --- Tùy chọn: hỏi đáp AI. Thiếu thì tắt hỏi đáp, phần còn lại vẫn chạy ---
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=

# --- Tùy chọn: đường dẫn Tesseract (mặc định /usr/bin/tesseract) ---
# TESSERACT_PATH=/usr/bin/tesseract

# Số kết nối tối đa trong pool (tùy chọn, mặc định 10)
DB_POOL_MAX=10
